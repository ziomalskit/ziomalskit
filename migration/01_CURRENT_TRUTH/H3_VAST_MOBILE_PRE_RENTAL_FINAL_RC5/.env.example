# H3 Vast Mobile — example runtime overrides
# Internal ComfyUI services
RENDER_COMFY_URL=http://127.0.0.1:8188
PROMPT_COMFY_URL=http://127.0.0.1:8189
H3_PANEL_PORT=7860

# Default non-persistent layout:
COMFY_ROOT=/workspace/ComfyUI
# Installer writes the actual interpreter selected by comfy-cli into runtime.env.
COMFY_PYTHON=
COMFY_INPUT_DIR=/workspace/ComfyUI/input
COMFY_OUTPUT_DIR=/workspace/ComfyUI/output
COMFY_MODELS_DIR=/workspace/ComfyUI/models

# Watchdog service restarts
RENDER_RESTART_CMD="bash /workspace/H3_VAST_MOBILE/scripts/service_ctl.sh restart render"
PROMPT_RESTART_CMD="bash /workspace/H3_VAST_MOBILE/scripts/service_ctl.sh restart prompt"
SERVICE_CTL=/workspace/H3_VAST_MOBILE/scripts/service_ctl.sh

# Vast lifecycle
VAST_CLI=vastai

# Set BOTH before install if using an attached persistent Local Volume.
# Example only; use the actual mount path shown by Vast.
H3_PERSISTENCE_MODE=
H3_PERSISTENT_ROOT=

# Optional fixed credentials. If password is blank during provisioning,
# the installer generates a random one and prints it once.
H3_PANEL_USER=h3
H3_PANEL_PASSWORD=
