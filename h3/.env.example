# H3 Vast Mobile — example runtime overrides
# Internal ComfyUI services
RENDER_COMFY_URL=http://127.0.0.1:8188
PROMPT_COMFY_URL=http://127.0.0.1:8189
RENDER_PORT=8188
PROMPT_PORT=8189
H3_PANEL_PORT=7860
H3_PANEL_URL=http://127.0.0.1:7860

# Parallel only: future render-ready prompts, excluding the active render and
# unapproved Review Pool. Integers clamp to 1..5; invalid values fall back to 3.
H3_PROMPT_PREFETCH=3

# Optional admin PTY. Only exactly 1 enables it; keep disabled for normal use.
# Enable ONLY when the panel is accessed through a trusted/private connection.
H3_ENABLE_TERMINAL=0

# Default non-persistent layout:
WORKSPACE=/workspace
COMFY_ROOT=/workspace/ComfyUI
# Explicit absolute Python path, or leave blank for DATA_ROOT/.h3-venv/bin/python.
# Every dependency/CLI/worker uses this same interpreter; ambient envs are ignored.
COMFY_PYTHON=
# Choose a CUDA devel image, compatible driver and this matching torch runtime.
H3_CUDA_VERSION=13.0
H3_BUILD_ROOT=/workspace/.h3-build
# Optional limit; automatically capped by RAM, CPU count and eight jobs.
H3_BUILD_JOBS=
# External trusted JSON mapping paths relative to COMFY_ROOT, for example:
# {"models/LLM/example.gguf": {"sha256": "<64 hex>", "size_bytes": 123}}
# Supply publisher/verified download checksums; never invent hashes to pass checks.
H3_MODEL_CHECKSUMS_FILE=
COMFY_INPUT_DIR=/workspace/ComfyUI/input
COMFY_OUTPUT_DIR=/workspace/ComfyUI/output
COMFY_MODELS_DIR=/workspace/ComfyUI/models

# Watchdog service restarts
RENDER_RESTART_CMD="bash /workspace/H3_VAST_MOBILE/scripts/service_ctl.sh restart render"
PROMPT_RESTART_CMD="bash /workspace/H3_VAST_MOBILE/scripts/service_ctl.sh restart prompt"
SERVICE_CTL=/workspace/H3_VAST_MOBILE/scripts/service_ctl.sh

# Vast lifecycle
VAST_CLI=vastai

# Set BOTH before install if using an attached persistent Local Volume.
# Example only; use the actual mount path shown by Vast.
H3_PERSISTENCE_MODE=
H3_PERSISTENT_ROOT=

# Optional fixed credentials. If password is blank during provisioning,
# the installer retains an existing runtime.env credential or generates one.
# Credentials are shell-quoted in mode-600 runtime.env and are never printed.
H3_PANEL_USER=h3
H3_PANEL_PASSWORD=
